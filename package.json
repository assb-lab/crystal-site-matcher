{
  "name": "crystal-site-matcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Estimate whether an ion fits a crystallographic site from coordination-polyhedron bond lengths and Shannon radii, and compute ion-conductor descriptors from CIF files.",
  "license": "MIT",
  "bin": {
    "csm-features": "./dist/csm-features.mjs"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && vp build --config vite.cli.config.ts",
    "build:cli": "vp build --config vite.cli.config.ts",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "data:fetch": "bash scripts/fetch-sources.sh",
    "data": "uv run --locked scripts/build-data.py .sources/pymatgen .sources/pymatgen-core .sources/BVlain",
    "samples": "uv run --locked scripts/make-samples.py",
    "features": "node dist/csm-features.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plugin-singlefile": "2.3.4",
    "vite-plus": "1.4.0"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12.16.1 <13"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "error"
    }
  }
}
