{
  "name": "crystal-site-matcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Estimate whether an ion fits a crystallographic site from coordination-polyhedron bond lengths and Shannon radii, and compute ion-conductor descriptors from CIF files.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "data:fetch": "bash scripts/fetch-sources.sh",
    "data": "uv run --locked scripts/build-data.py .sources/pymatgen .sources/pymatgen-core .sources/BVlain",
    "samples": "uv run --locked scripts/make-samples.py"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=12.3.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.3.4",
      "onFail": "error"
    }
  }
}
